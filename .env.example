# Signing secret do webhook (Linear → Settings → API → Webhooks)
LINEAR_WEBHOOK_SECRET=
HOST=0.0.0.0
PORT=8000

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TASK_QUEUE=software-factory

# Worker: sandbox E2B + Claude Code
E2B_API_KEY=
# E2B_TEMPLATE=claude
# Auth do Claude Code no sandbox: defina exatamente UMA das duas.
# Chave da API (cobrança por token, console.anthropic.com)
ANTHROPIC_API_KEY=
# ou token da assinatura Claude (gerado com `claude setup-token`)
CLAUDE_CODE_OAUTH_TOKEN=
# Token fine-grained do GitHub restrito ao repo alvo, Contents: Read and write
# (push da branch do plano; o agente no sandbox consegue lê-lo)
GITHUB_TOKEN=
# Repo que a fábrica opera, formato owner/repo
TARGET_REPO=
# Personal API key do Linear (Settings → Security & access → Personal API keys),
# com permissão de escrita em issues (move o status da issue)
LINEAR_API_KEY=
